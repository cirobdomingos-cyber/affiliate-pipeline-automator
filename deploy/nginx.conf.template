# nginx reverse-proxy routing.
#
# $PORT is injected by Railway at container start and substituted by
# envsubst in entrypoint.sh before nginx loads this file.
#
# Routing strategy:
# - FastAPI-owned paths (public redirect, bridge page, health, API docs,
#   and any REST endpoint the admin UI itself calls over HTTP in the
#   future) → uvicorn on localhost:8000.
# - Everything else → streamlit on localhost:8501.
#
# Streamlit relies heavily on a WebSocket connection at /_stcore/stream;
# the `/` location block enables Upgrade/Connection headers so WS works
# transparently.

server {
    listen ${PORT} default_server;
    server_name _;

    # Large uploads and long LLM polls — generous timeouts.
    client_max_body_size 50M;
    proxy_read_timeout 600;
    proxy_send_timeout 600;
    proxy_connect_timeout 60;
    send_timeout 600;

    # FastAPI public endpoints + API surface.
    location /r/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /bp/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # MailerLite embed form routes FastAPI-side; everything under
    # /mailerlite/ is a FastAPI endpoint.
    location /mailerlite/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Streamlit catch-all (includes /_stcore websocket).
    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
