# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — creative generation providers
# Replicate is preferred (more forgiving international billing).
REPLICATE_API_TOKEN=r8_your-token-here
# FAL_API_KEY=your-fal-key-here

# Override provider selection when both are set
# CREATIVE_PROVIDER=replicate   # or 'fal'

# Optional — override default models
# REPLICATE_IMAGE_MODEL=ideogram-ai/ideogram-v3-balanced
# REPLICATE_VIDEO_MODEL=google/veo-3
# FAL_IMAGE_MODEL=fal-ai/ideogram/v3
# FAL_VIDEO_MODEL=fal-ai/veo3

# Optional — Stage 5 (email)
# MAILERLITE_API_KEY=your-mailerlite-key

# Public URL prefix used to build /r/{slug} and /bp/{slug} links shown in the
# admin UI. In local dev this defaults to http://localhost:8000. In production
# set it to the deployed api service URL, e.g. https://affiliate-api.up.railway.app
APP_BASE_URL=http://localhost:8000

# Persistent storage directory for the DuckDB file. Defaults to the repo root
# locally. On Railway, set this to the mount path of a Railway Volume shared
# between the api and ui services, e.g. /data
# DATA_DIR=/data
